= turbo_frame_tag "tab_content" do

  %h1 Patients

  = render "notification"

  = link_to "New Patient", new_patient_path, data: { turbo_frame: "modal" }

  %table{border: "1"}
    %thead
      %tr
        %th Name
        %th Age
        %th Gender
        %th Phone
        %th{ colspan: "3"} Actions

    %tbody#patients
      - @patients.each do |patient|
        = render patient

  %div
    %p
      %strong{ style: "color: red; font-weight: bold;"} Patients Count:
      %span#patient_count{ style: "color: blue; font-weight: bold;" }
        = @patients_count
        
= turbo_frame_tag "modal"