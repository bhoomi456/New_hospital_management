= turbo_frame_tag "tab_content" do


  %h1 Hospitals
  = turbo_frame_tag "notice"


  = link_to "New Hospital", new_hospital_path, data: { turbo_frame: "modal" }

  %table{border: "1"}
    %thead
      %tr
        %th Name
        %th{ colspan: "3"} Actions

    %tbody#hospitals
      - @hospitals.each do |hospital|
        = render hospital
        
  = paginate @hospitals

= turbo_frame_tag "doctor_details" do
  %h3 Doctor Details
  %p Select a hospital to view doctors.

= turbo_frame_tag "modal"