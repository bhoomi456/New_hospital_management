%div{style: "display: flex; justify-content: center;"}
  %div
    - if notice
      %p{style: "color: red;" }
        = notice
    
    %h Doctors
    = link_to "New Doctor", new_doctor_path

    
    %table{border: "1"}
      %thead
        %tr
          %th name
          %th specialization
          %th hospital
          %th{ colspan: "2"} Actions
    
      %tbody
        - @doctors.each do |doctor|
          %tr
            %td= doctor.name
            %td= doctor.specialization
            %td= doctor.hospital.name
            %td= link_to "Show", doctor_path(doctor)
            %td= link_to "Edit", edit_doctor_path(doctor)
