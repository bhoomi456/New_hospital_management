= turbo_frame_tag "tab_content" do

  %div{style: "display: flex; justify-content: center;"}
    %div

      %h Doctors
      = render "notification"

      = link_to "New Doctor", new_doctor_path, data: { turbo_frame: "modal" }


      %table{border: "1"}
        %thead
          %tr
            %th name
            %th specialization
            %th hospital
            %th{ colspan: "3"} Actions

        %tbody#doctors
          - @doctors.each do |doctor|
            = render doctor
      %div
        %p
          %strong{ style: "color: red; font-weight: bold;"} Doctors Count:
          %span#patient_count{ style: "color: blue; font-weight: bold;" }
            = @doctors_count

= turbo_frame_tag "modal"