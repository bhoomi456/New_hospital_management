%tr{ id: dom_id(doctor) }
  %td= doctor.name
  %td= doctor.specialization
  %td= doctor.hospital.name
  %td= link_to "Show", doctor_path(doctor),data: { turbo_frame: "modal" }
  %td= link_to "Edit", edit_doctor_path(doctor),data: { turbo_frame: "modal" }
  %td= link_to "Delete",doctor_path(doctor),data: {turbo_method: :delete,turbo_confirm: "Are you sure?"}
